#!/bin/sh
# git credential helper: serves the per-run forge token. Only "get" is answered.
[ "${1:-}" = get ] || exit 0
tok=
if [ -r "${JAUNT_RUN_DIR:-/run/jauntbox-run}/token" ]; then
	tok=$(cat "${JAUNT_RUN_DIR:-/run/jauntbox-run}/token")
fi
if [ -z "$tok" ]; then
	echo quit=1
	exit 0
fi
echo username=x-access-token
echo "password=$tok"
