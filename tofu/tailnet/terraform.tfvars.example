# Copy to terraform.tfvars and fill in. Credentials come from the environment:
# TAILSCALE_API_KEY / TAILSCALE_TAILNET.
#
# username => Tailscale login. The username is the box tag suffix and MUST match the
# `user` the engineer passes to tofu/hetzner or tofu/upcloud.
engineers = {
  alice = "alice@wa-systems.eu"
  bob   = "bob@wa-systems.eu"
}

# This root manages the WHOLE tailnet ACL. Uncomment to let it take over an existing
# policy (it will replace the current ACL content):
# overwrite_existing_content = true
