#cloud-config
# gbrain — the shared, always-on box. Deliberately a near-copy of modules/jauntbox's
# template so the two stay diffable; the difference is that NOTHING here installs the
# idle-watch agent or the self-delete script. This box runs until `gbrain_on` is false.
#
# The /opt/jaunt and /etc/jaunt paths are NOT a copy-paste slip: dev-setup.sh is shared with
# jauntbox (modules/provision/) and hardcodes /etc/jaunt/provision.env and
# /opt/jaunt/dev-setup-user.sh. Same for /home/.jaunt — the volumes are per-box, so there is
# no collision.
write_files:
  # Tailscale auth key in a 0600 file (read by `tailscale up`) instead of on the
  # command line, so it never lands in /var/log/cloud-init-output.log.
  - path: /etc/jaunt/ts.key
    permissions: '0600'
    encoding: b64
    content: ${tailscale_key_b64}
  # systemd drop-in: relocate tailscaled's state FILE onto the persistent volume so node
  # identity (and thus the MagicDNS hostname) survives box replacement. We do NOT symlink
  # /var/lib/tailscale — the packaged unit sets `StateDirectory=tailscale`, and systemd
  # refuses to set up a StateDirectory that is a symlink ("too many levels of symbolic
  # links"), which stops the service from starting. Instead we append `--state=<volume>`
  # via $FLAGS; tailscaled's flag parser takes the LAST --state, overriding the packaged
  # `--state=/var/lib/tailscale/...`. Written in write_files (config stage) so it is on
  # disk before the package install auto-starts tailscaled.
  #   RequiresMountsFor=/home — on a later reboot, wait for the volume mount before start.
  #   ProtectHome=no          — defensive: guarantee the service can write under /home even
  #                             if a future packaged unit hardens it (harmless no-op today).
  - path: /etc/systemd/system/tailscaled.service.d/10-jaunt-state.conf
    permissions: '0644'
    content: |
      [Unit]
      RequiresMountsFor=/home
      [Service]
      Environment=FLAGS=--state=/home/.jaunt/tailscaled.state
      ProtectHome=no
  - path: /opt/jaunt/setup.sh
    permissions: '0755'
    encoding: b64
    content: ${setup_b64}
  - path: /opt/jaunt/dev-setup.sh
    permissions: '0755'
    encoding: b64
    content: ${provision_b64}
  - path: /opt/jaunt/dev-setup-user.sh
    permissions: '0755'
    encoding: b64
    content: ${provision_user_b64}
  - path: /etc/jaunt/provision.env
    permissions: '0644'
    content: |
      JAUNT_USER=${user}
      JAUNT_UID=2000
      JAUNT_INSTALL_TOOLCHAIN=${install_toolchain}
      JAUNT_DOCKER_DATA_ROOT=${docker_data_root}
runcmd:
  - mkdir -p /var/lib/jaunt
  # wait for the data volume to appear (Hetzner attaches it asynchronously, so the
  # device node may not exist yet when cloud-init runs; on UpCloud it is present at boot)
  - for i in $(seq 1 60); do [ -b ${volume_device} ] && break; sleep 2; done
  # mount the persistent volume at /home (format only if it has no filesystem yet)
  - if ! blkid ${volume_device}; then mkfs.ext4 -F ${volume_device}; fi
  - mkdir -p /mnt/jaunt-home && mount ${volume_device} /mnt/jaunt-home
  - if [ ! -d /mnt/jaunt-home/home-seeded ]; then cp -a /home/. /mnt/jaunt-home/ 2>/dev/null || true; mkdir -p /mnt/jaunt-home/home-seeded; fi
  - umount /mnt/jaunt-home && mount ${volume_device} /home
  - grep -q '${volume_device} /home' /etc/fstab || echo '${volume_device} /home ext4 defaults,nofail 0 2' >> /etc/fstab
  # tailscale — install, then make sure the daemon is up before `tailscale up`
  # (running `up` before tailscaled's socket exists is a boot-time race that leaves
  # the box installed-but-not-connected)
  - curl -fsSL https://tailscale.com/install.sh | sh
  # create the volume-backed state dir BEFORE tailscaled starts (the drop-in in write_files
  # points --state here). On a replacement box this dir already holds tailscaled.state, so
  # the node reclaims its identity and keeps its hostname (no `-1`); on a fresh box it is
  # empty and the auth-key join below creates it.
  - mkdir -p /home/.jaunt && chmod 700 /home/.jaunt
  - systemctl daemon-reload
  - systemctl enable tailscaled
  # restart (not just start) so the state drop-in is applied even if the package install
  # already auto-started tailscaled.
  - systemctl restart tailscaled
  - for i in $(seq 1 30); do [ -S /var/run/tailscale/tailscaled.sock ] && break; sleep 1; done
  # shred the reusable auth key on a successful join — persisted identity means a running box
  # no longer needs it, and a live box is where a compromise would read it. cloud-init re-writes
  # it fresh on the next instance's first boot for the slow-replace (GC'd node) re-auth fallback.
  - tailscale up --auth-key="$(cat /etc/jaunt/ts.key)" --hostname=${hostname} --advertise-tags=${tailscale_tag} --ssh ${tailscale_extra_args} && shred -u /etc/jaunt/ts.key
  # provision the engineer user, Docker, and the dev toolchain (long on a cold volume;
  # the box is already reachable over Tailscale by now)
  - /opt/jaunt/dev-setup.sh
  # idempotent project setup — empty today; gbrain is installed by hand on the box
  - /opt/jaunt/setup.sh || true
